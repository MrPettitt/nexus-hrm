<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Nexus HRM</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "/Index";

    // The signed-in user comes from the session; anonymous pages (sign in) skip the app shell.
    var me   = int.TryParse(Context.Session.GetString("UserId"), out var sessionId) ? _data.GetEmployee(sessionId) : null;
    if (me is { IsOffboarded: true }) { me = null; }
    var role      = me?.Role ?? "";
    var userName  = me?.Name ?? "";
    var userInit  = me?.Initials ?? "";
    var userColor = me?.AvatarColor ?? "#5B5BD6";
    var userId    = me?.Id ?? 0;

    var pendingLeave = me == null ? 0 : _data.PendingFor(me);

    // Unread messages for current user (broadcast or addressed to them)
    var unreadMsgs = me == null
        ? new List<NexusHRM.Models.HrMessage>()
        : _data.Messages.Where(m => _data.IsInbox(m, userId) && !m.ReadBy.Contains(userId))
                        .OrderByDescending(m => m.SentAt).ToList();
    int unreadCount = unreadMsgs.Count;

    // Bell badge = unread messages + leave awaiting this user's decision
    int bellCount = unreadCount + pendingLeave;

    var pendingLeaveItems = me == null
        ? new List<NexusHRM.Models.LeaveRequest>()
        : _data.LeaveRequests.Where(l => _data.CanDecide(me, l)).OrderByDescending(l => l.AppliedDate).Take(5).ToList();

    var flash      = TempData["Flash"] as string;
    var flashError = TempData["FlashError"] as string;
}

@if (me != null)
{
    <div class="app-shell">

        <!-- ── Sidebar ── -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <div class="logo-text">Nexus<span class="logo-accent"> HRM</span></div>
                <div class="logo-sub">Human Resources</div>
            </div>

            <nav class="sidebar-nav">
                @{
                    var navItems = new[]
                    {
                        new { Href = "/",            Label = "Dashboard",    Icon = "grid"     },
                        new { Href = "/Employees",   Label = "Employees",    Icon = "people"   },
                        new { Href = "/Leave",       Label = "Leave",        Icon = "calendar" },
                        new { Href = "/Payroll",     Label = "Payroll",      Icon = "wallet"   },
                        new { Href = "/Attendance",  Label = "Attendance",   Icon = "clock"    },
                        new { Href = "/Performance", Label = "Performance",  Icon = "star"     },
                        new { Href = "/Messages",    Label = "Messages",     Icon = "mail"     },
                    };
                }
                @foreach (var item in navItems)
                {
                    var isActive = item.Href == "/" ? currentPage == "/Index" : currentPage.StartsWith(item.Href);
                    <a href="@item.Href" class="nav-item @(isActive ? "active" : "")">
                        <span class="nav-icon">@Html.Raw(GetIcon(item.Icon))</span>
                        @item.Label
                        @if (item.Label == "Leave" && pendingLeave > 0)
                        {
                            <span class="nav-badge">@pendingLeave</span>
                        }
                        @if (item.Label == "Messages" && unreadCount > 0)
                        {
                            <span class="nav-badge">@unreadCount</span>
                        }
                    </a>
                }
            </nav>

            <div class="sidebar-footer">
                <div class="user-info">
                    <div class="avatar" style="background:@userColor">@userInit</div>
                    <div class="user-meta">
                        <div class="user-name">@userName</div>
                        <div class="user-role">@role</div>
                    </div>
                </div>
                <form method="post" asp-page="/Account/Logout" style="margin:0">
                    <button type="submit" class="sign-out-btn">
                        @Html.Raw(GetIcon("logout"))
                        Sign out
                    </button>
                </form>
            </div>
        </aside>

        <!-- ── Main Area ── -->
        <div class="main-area">
            <!-- Top Bar -->
            <header class="topbar">
                <h2 class="page-title">@ViewData["Title"]</h2>
                <div class="topbar-right">
                    <!-- Global search navigates to Employees on Enter -->
                    <div class="search-wrap">
                        <span class="search-icon">@Html.Raw(GetIcon("search"))</span>
                        <input type="text" id="globalSearch" placeholder="Search employees"
                               class="search-input" autocomplete="off" />
                    </div>

                    <!-- Notification bell -->
                    <div class="notif-wrap" id="notifWrap">
                        <button class="notif-btn @(bellCount > 0 ? "has-notif" : "")"
                                id="notifBtn" aria-label="Notifications">
                            @Html.Raw(GetIcon("bell"))
                            @if (bellCount > 0)
                            {
                                <span class="notif-count">@(bellCount > 9 ? "9+" : bellCount.ToString())</span>
                            }
                        </button>

                        <!-- Dropdown panel -->
                        <div class="notif-panel" id="notifPanel" style="display:none">
                            <div class="notif-panel-header">
                                <span class="fw-bold" style="font-size:13px">Notifications</span>
                                @if (bellCount > 0)
                                {
                                    <span class="muted small">@bellCount unread</span>
                                }
                            </div>

                            <!-- Pending leave (Manager/HR only) -->
                            @if (pendingLeaveItems.Any())
                            {
                                <div class="notif-section-label">Pending Leave</div>
                                @foreach (var l in pendingLeaveItems)
                                {
                                    var emp = _data.GetEmployee(l.EmployeeId);
                                    <a href="/Leave" class="notif-item">
                                        <div class="avatar sm" style="background:@(emp?.AvatarColor ?? "#ccc")">@(emp?.Initials ?? "?")</div>
                                        <div class="notif-item-body">
                                            <div class="notif-item-title">@(emp?.Name ?? "Unknown"), @l.LeaveType leave</div>
                                            <div class="notif-item-sub">@l.Days day(s) · @l.FromDate.ToString("d MMM")</div>
                                        </div>
                                    </a>
                                }
                            }

                            <!-- Unread messages -->
                            @if (unreadMsgs.Any())
                            {
                                <div class="notif-section-label">Messages</div>
                                @foreach (var m in unreadMsgs.Take(4))
                                {
                                    var sender = _data.GetEmployee(m.FromId);
                                    <a href="/Messages?open=@m.Id" class="notif-item">
                                        <div class="avatar sm" style="background:@(sender?.AvatarColor ?? "#ccc")">@(sender?.Initials ?? "?")</div>
                                        <div class="notif-item-body">
                                            <div class="notif-item-title">@m.Subject</div>
                                            <div class="notif-item-sub">@(sender?.Name ?? "HR") · @m.SentAt.ToString("d MMM")</div>
                                        </div>
                                    </a>
                                }
                            }

                            @if (!pendingLeaveItems.Any() && !unreadMsgs.Any())
                            {
                                <div class="notif-empty">
                                    @Html.Raw(GetIcon("check"))
                                    All caught up
                                </div>
                            }

                            <a href="/Messages" class="notif-panel-footer">View all messages</a>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="page-content">
                @if (!string.IsNullOrEmpty(flash))
                {
                    <div class="toast-success" id="successToast" role="status">@flash</div>
                }
                @if (!string.IsNullOrEmpty(flashError))
                {
                    <div class="toast-error" id="errorToast" role="alert">@flashError</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>

@functions {
    string GetIcon(string name) => name switch
    {
        "grid"     => "<svg width='15' height='15' fill='none' stroke='currentColor' stroke-width='2' viewBox='0 0 24 24'><rect x='3' y='3' width='7' height='7' rx='1'/><rect x='14' y='3' width='7' height='7' rx='1'/><rect x='3' y='14' width='7' height='7' rx='1'/><rect x='14' y='14' width='7' height='7' rx='1'/></svg>",
        "people"   => "<svg width='15' height='15' fill='none' stroke='currentColor' stroke-width='2' viewBox='0 0 24 24'><path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/><path d='M23 21v-2a4 4 0 0 0-3-3.87'/><path d='M16 3.13a4 4 0 0 1 0 7.75'/></svg>",
        "calendar" => "<svg width='15' height='15' fill='none' stroke='currentColor' stroke-width='2' viewBox='0 0 24 24'><rect x='3' y='4' width='18' height='18' rx='2'/><line x1='16' y1='2' x2='16' y2='6'/><line x1='8' y1='2' x2='8' y2='6'/><line x1='3' y1='10' x2='21' y2='10'/></svg>",
        "wallet"   => "<svg width='15' height='15' fill='none' stroke='currentColor' stroke-width='2' viewBox='0 0 24 24'><path d='M20 12V8H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h14v4'/><path d='M4 6v12a2 2 0 0 0 2 2h14v-4'/><circle cx='16' cy='14' r='1' fill='currentColor'/></svg>",
        "clock"    => "<svg width='15' height='15' fill='none' stroke='currentColor' stroke-width='2' viewBox='0 0 24 24'><circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/></svg>",
        "star"     => "<svg width='15' height='15' fill='none' stroke='currentColor' stroke-width='2' viewBox='0 0 24 24'><polygon points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2'/></svg>",
        "mail"     => "<svg width='15' height='15' fill='none' stroke='currentColor' stroke-width='2' viewBox='0 0 24 24'><path d='M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z'/><polyline points='22,6 12,13 2,6'/></svg>",
        "search"   => "<svg width='13' height='13' fill='none' stroke='currentColor' stroke-width='2' viewBox='0 0 24 24'><circle cx='11' cy='11' r='8'/><line x1='21' y1='21' x2='16.65' y2='16.65'/></svg>",
        "bell"     => "<svg width='14' height='14' fill='none' stroke='currentColor' stroke-width='2' viewBox='0 0 24 24'><path d='M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9'/><path d='M13.73 21a2 2 0 0 1-3.46 0'/></svg>",
        "check"    => "<svg width='14' height='14' fill='none' stroke='currentColor' stroke-width='2' viewBox='0 0 24 24'><polyline points='20 6 9 17 4 12'/></svg>",
        "logout"   => "<svg width='13' height='13' fill='none' stroke='currentColor' stroke-width='2' viewBox='0 0 24 24'><path d='M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4'/><polyline points='16 17 21 12 16 7'/><line x1='21' y1='12' x2='9' y2='12'/></svg>",
        "plus"     => "<svg width='13' height='13' fill='none' stroke='currentColor' stroke-width='2.5' viewBox='0 0 24 24'><line x1='12' y1='5' x2='12' y2='19'/><line x1='5' y1='12' x2='19' y2='12'/></svg>",
        _          => "",
    };
}
